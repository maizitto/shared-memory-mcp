{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shared-memory-example",
  "main": "../src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "shared-memory-example",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../migrations"
  }],
  "ratelimits": [
    { "name": "AUTH_LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_API_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "MEMORY_ENABLED": "false",
    "MEMORY_REVIEW_ENABLED": "true",
    "AUTH_GUARDS_REQUIRED": "true",
    "MEMORY_PUBLIC_ORIGIN": "https://memory.example.invalid",
    "GITHUB_OWNER_ID": "12345",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_YOUR_PUBLIC_CLIENT_ID",
    "MEMORY_REVIEW_COLLECTIONS": "shared",
    "MEMORY_SEARCH_ENABLED": "false",
    "MEMORY_LEXICAL_ENABLED": "true",
    "MEMORY_OAUTH_ENABLED": "false",
    "MEMORY_OAUTH_COLLECTIONS": "shared"
  }
}
